NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=

# Google AI Studio Gemini key. The same key can be used when changing supported models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Razorpay dashboard > Account & Settings > API Keys
# Use rzp_test_... keys locally and live keys only in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta Commerce Manager Catalog (server-side only)
# Verified against Graph API v26.0. Never expose META_ACCESS_TOKEN to React/browser code.
META_GRAPH_API_VERSION=v26.0
META_CATALOG_ID=
META_ACCESS_TOKEN=

# Optional worker tuning
META_REQUEST_TIMEOUT_MS=15000
META_SYNC_WORKER_INTERVAL_MS=15000
META_SYNC_MAX_ATTEMPTS=5
META_SYNC_CONCURRENCY=2

# Meta App (developers.facebook.com → App → Settings → Basic)
META_APP_ID=
META_APP_SECRET=

# WhatsApp Cloud API (server-side only — never expose to React)
# App → WhatsApp → API Setup + Business Settings → System users
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Random string you invent; same value goes in Meta Webhook Verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional inbound WhatsApp voice calling. Also enable Voice calls in Manage WhatsApp after staging verification.
PULSE_VOICE_ENABLED=false
PULSE_VOICE_OUTBOUND_ENABLED=false
PULSE_VOICE_AGENT_NAME=pulse-whatsapp-voice
MAX_CALL_DURATION_SECONDS=600
MAX_CONCURRENT_CALLS=3
PULSE_VOICE_PROVIDER=gemini
# Google AI Studio API Keys: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional OpenAI fallback: set PULSE_VOICE_PROVIDER=openai, then configure these.
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Customer WhatsApp OTP + transactional template names (create/approve in WhatsApp Manager)
WHATSAPP_TEMPLATE_OTP=pulse_otp_verify
WHATSAPP_TEMPLATE_OTP_LANG=en_GB
WHATSAPP_TEMPLATE_BOOKING_CONFIRM=booking_confirmation
WHATSAPP_TEMPLATE_BOOKING_CONFIRM_LANG=en
WHATSAPP_TEMPLATE_ORDER_CONFIRM=order_confirmation
WHATSAPP_TEMPLATE_ORDER_CONFIRM_LANG=en
# Utility template with a PDF header, customer name, order ID, and dynamic Track Order button.
WHATSAPP_TEMPLATE_ORDER_INVOICE=purchase_receipt_3
WHATSAPP_TEMPLATE_ORDER_INVOICE_LANG=en_US
WHATSAPP_TEMPLATE_PAYMENT_FAILED=payment_unsuccessful
WHATSAPP_TEMPLATE_PAYMENT_FAILED_LANG=en
# Meta template name uses this spelling. The Receipt URL must end with /orders?id={{1}}.
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=payment_recieved
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED_LANG=en_US
WHATSAPP_TEMPLATE_ORDER_SHIPMENT=order_shipment
WHATSAPP_TEMPLATE_ORDER_SHIPMENT_LANG=en
WHATSAPP_TEMPLATE_CUSTOMER_PRODUCT_REVIEW=customer_product_review
WHATSAPP_TEMPLATE_CUSTOMER_PRODUCT_REVIEW_LANG=en
WHATSAPP_TEMPLATE_PRODUCT_REVIEW_ALERT=product_review_alert
WHATSAPP_TEMPLATE_PRODUCT_REVIEW_ALERT_LANG=en

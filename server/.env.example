NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=

# Google AI Studio Gemini key. The same key can be used when changing supported models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Razorpay dashboard > Account & Settings > API Keys
# Use rzp_test_... keys locally and live keys only in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta Commerce Manager Catalog (server-side only)
# Verified against Graph API v26.0. Never expose META_ACCESS_TOKEN to React/browser code.
META_GRAPH_API_VERSION=v26.0
META_CATALOG_ID=
META_ACCESS_TOKEN=

# Optional worker tuning
META_REQUEST_TIMEOUT_MS=15000
META_SYNC_WORKER_INTERVAL_MS=15000
META_SYNC_MAX_ATTEMPTS=5
META_SYNC_CONCURRENCY=2

# Meta App (developers.facebook.com → App → Settings → Basic)
META_APP_ID=
META_APP_SECRET=

# WhatsApp Cloud API (server-side only — never expose to React)
# App → WhatsApp → API Setup + Business Settings → System users
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Random string you invent; same value goes in Meta Webhook Verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
